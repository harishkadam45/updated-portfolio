---
export type IconName =
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'phone'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'external'
  | 'menu'
  | 'close'
  | 'code'
  | 'server'
  | 'design'
  | 'sparkles'
  | 'check'
  | 'location'
  | 'download';

interface Props {
  name: IconName;
  size?: number;
  className?: string;
  strokeWidth?: number;
  ariaLabel?: string;
}

