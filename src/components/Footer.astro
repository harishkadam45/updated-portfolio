---
import { site, navLinks } from '@/data/site';
import Icon from './Icon.astro';
import { projects, experience, education } from '@/data/content';

const stats = [
  { value: projects.length, label: 'Projects Built' },
  { value: experience.length, label: 'Years Experience' },
  { value: education.length, label: 'Degrees Earned' },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <h3 class="footer-title">{site.name}</h3>
        <p class="footer-role">{site.role}</p>
        <p class="footer-desc">{site.headline}</p>
        <div class="social-row">
          <a class="icon-link" href={site.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
            <Icon name="github" size={20} />
          </a>
          <a class="icon-link" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
            <Icon name="linkedin" size={20} />
          </a>
          <a class="icon-link" href={`mailto:${site.email}`} aria-label="Email">
            <Icon name="mail" size={20} />
          </a>
          <a class="icon-link" href={`tel:${site.phone}`} aria-label="Phone">
            <Icon name="phone" size={20} />
          </a>
        </div>
      </div>

      <nav class="footer-col" aria-label="Footer navigation">
        <h4 class="footer-heading">Navigate</h4>
        <ul role="list" class="footer-links">
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-col">
        <h4 class="footer-heading">Contact</h4>
        <ul role="list" class="footer-links">
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <a href={`tel:${site.phone}`}>{site.phone}</a>
          </li>
          <li>{site.location}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} {site.name}. Built with Astro.</p>
      <p class="footer-detail">Designed &amp; developed by {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-1);
    padding-block: var(--space-10) var(--space-6);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .footer-title {
    font-size: var(--fs-2xl);
    margin-bottom: 0.25rem;
  }

  .footer-role {
    font-family: var(--font-mono);
    color: var(--primary);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-3);
  }

  .footer-desc {
    color: var(--text-2);
    max-width: 24rem;
    margin-bottom: var(--space-5);
  }

  .social-row {
    display: flex;
    gap: 0.75rem;
  }

  .footer-heading {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-3);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    display: grid;
    gap: 0.6rem;
  }

  .footer-links a {
    color: var(--text-2);
    transition: var(--transition);
  }

  .footer-links a:hover {
    color: var(--primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-size: var(--fs-sm);
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
