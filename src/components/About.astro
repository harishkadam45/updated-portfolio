---
import Icon from './Icon.astro';
import { site } from '@/data/site';
---

<section class="section" id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-text reveal">
        <h2 class="section-heading"><span class="num">01.</span> About Me</h2>

        <div class="about-copy">
          <p>
            Hello! I'm <strong>{site.name}</strong>, a {site.role.toLowerCase()}
            based in {site.location}. My passion grew from curiosity about how the
            web works into a career building products that people use every day.
          </p>
          <p>
            I enjoy the intersection of design and engineering — taking a beautiful
            idea and bringing it to life with clean, maintainable, and performant
            code. I care deeply about accessibility, semantics, and the details
            that make an interface feel effortless.
          </p>
          <p>
            When I'm not building, I love exploring new tools, sharpening my
            problem-solving skills, and continuously learning to level up my craft.
          </p>
        </div>

        <a href="#contact" class="btn btn-ghost">
          More about me <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="about-card reveal" style="--d:1">
        <div class="services-frame">
          <h3 class="services-heading">What I Offer</h3>
          <p class="services-sub">As a freelance web developer</p>
          <ul class="services-list">
            <li>Business Website Development</li>
            <li>Figma to Responsive Website</li>
            <li>React.js Frontend Development</li>
            <li>Landing Page Development</li>
            <li>Website Redesign &amp; Modernization</li>
            <li>Website Maintenance &amp; Bug Fixes</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  .about-copy {
    display: grid;
    gap: var(--space-4);
    color: var(--text-2);
    margin-bottom: var(--space-6);
    max-width: 42rem;
  }

  .about-copy strong {
    color: var(--text-1);
  }

  .services-frame {
    position: relative;
    max-width: 360px;
    margin-inline: auto;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--bg-3), var(--bg-1));
    border: 1px solid var(--border);
    color: var(--text-2);
  }

  /* thin stacked offset border for a subtle "floating" effect */
  .services-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(10px, 10px);
    border: 1px solid rgba(109, 123, 255, 0.22);
    border-radius: var(--radius-lg);
    z-index: -1;
  }

  .services-heading {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: var(--space-2);
  }

  .services-sub {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--primary);
    margin-bottom: var(--space-5);
  }

  .services-list {
    display: grid;
    gap: var(--space-3);
  }

  .services-list li {
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .services-frame {
      max-width: 100%;
    }
  }
</style>
