---
import { site } from '@/data/site';
import Icon from './Icon.astro';
---

<section class="section" id="contact">
  <div class="container">
    <div class="contact-wrap reveal">
      <div class="contact-head">
        <p class="contact-eyebrow"><span class="num">06.</span> What's Next?</p>
        <h2 class="contact-title">Get In Touch</h2>
        <p class="contact-desc">
          I'm currently open to new opportunities and collaborations.
          Whether you have a question, an idea, or just want to say hi —
          my inbox is always open. I'll get back to you as soon as I can.
        </p>

        <a class="btn btn-primary contact-cta" href={`mailto:${site.email}`}>
          <Icon name="mail" size={18} /> Say Hello
        </a>
      </div>

      <div class="contact-panel">
        <h3 class="contact-panel-title">Direct Contact</h3>
        <div class="contact-list">
          <a class="contact-row" href={`mailto:${site.email}`}>
            <span class="contact-icon"><Icon name="mail" size={18} /></span>
            <span class="contact-info">
              <span class="contact-label">Email</span>
              <span class="contact-value">{site.email}</span>
            </span>
          </a>
          <a class="contact-row" href={`tel:${site.phone.replace(/\s/g, '')}`}>
            <span class="contact-icon"><Icon name="phone" size={18} /></span>
            <span class="contact-info">
              <span class="contact-label">Phone</span>
              <span class="contact-value">{site.phone}</span>
            </span>
          </a>
          <a class="contact-row" href={site.socials.github} target="_blank" rel="noopener noreferrer">
            <span class="contact-icon"><Icon name="github" size={18} /></span>
            <span class="contact-info">
              <span class="contact-label">GitHub</span>
              <span class="contact-value">github.com/harishkadam45</span>
            </span>
          </a>
          <a class="contact-row" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
            <span class="contact-icon"><Icon name="linkedin" size={18} /></span>
            <span class="contact-info">
              <span class="contact-label">LinkedIn</span>
              <span class="contact-value">in/harish-kadam</span>
            </span>
          </a>
          <div class="contact-row">
            <span class="contact-icon"><Icon name="location" size={18} /></span>
            <span class="contact-info">
              <span class="contact-label">Location</span>
              <span class="contact-value">{site.location}</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-wrap {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  .contact-head {
    max-width: 34rem;
  }

  .contact-eyebrow {
    font-family: var(--font-mono);
    color: var(--primary);
    margin-bottom: var(--space-3);
  }

  .contact-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-5);
  }

  .contact-desc {
    color: var(--text-2);
    font-size: var(--fs-lg);
    margin-bottom: var(--space-6);
  }

  .contact-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .contact-panel-title {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .contact-list {
    display: grid;
    gap: var(--space-2);
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    transition: var(--transition);
  }

  a.contact-row:hover {
    background: var(--surface-hover);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: rgba(109, 123, 255, 0.1);
    color: var(--primary);
    flex-shrink: 0;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contact-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }

  .contact-value {
    font-size: var(--fs-sm);
    color: var(--text-1);
    word-break: break-word;
  }

  @media (max-width: 820px) {
    .contact-wrap {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
