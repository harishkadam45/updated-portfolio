---
import { navLinks, site } from '@/data/site';
import Icon from './Icon.astro';

import logoAsset from '@/assets/Harish_kadam.png';

const whatsappUrl = `https://wa.me/${site.phone.replace(/\D/g, '')}`;
---

<header class="header">
  <div class="container header-inner">
    <a href="#top" class="brand" aria-label={`${site.name} - home`}>
      <img class="brand-mark" src={logoAsset.src} alt={site.name} width={logoAsset.width} height={logoAsset.height} />
      <span class="brand-text">
        <span class="brand-name">{site.name}</span>
        <span class="brand-role">// {site.role}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul role="list" class="nav-list">
        {navLinks.map((link) => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href={whatsappUrl} class="whatsapp-btn nav-cta" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
    </a>

    <button class="nav-toggle" data-nav-toggle aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-menu">
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul role="list" class="mobile-list">
      {navLinks.map((link, i) => (
        <li class:list={[{ 'has-num': true }]}>
          <a href={link.href} class="mobile-link">
            <span class="mobile-num">0{i + 1}</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="#contact" class="btn btn-primary mobile-cta">Get In Touch</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(6, 7, 14, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-mark {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-strong);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-weight: 700;
    font-size: var(--fs-sm);
  }

  .brand-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
  }

  .nav-list {
    display: flex;
    gap: 1.75rem;
  }

  .nav-link {
    font-size: var(--fs-sm);
    color: var(--text-2);
    transition: var(--transition);
    position: relative;
  }

  .nav-link:hover::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 2px;
    width: 100%;
    background: var(--gradient);
    border-radius: var(--radius-full);
  }

  .nav-link:hover {
    color: var(--text-1);
  }

  .whatsapp-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
    transition: var(--transition);
  }

  .whatsapp-btn:hover {
    transform: translateY(-2px) scale(1.06);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.55);
  }

  .nav-toggle {
    display: none;
    color: var(--text-1);
  }

  .mobile-menu {
    display: none;
  }

  .icon-close {
    display: none;
  }

  @media (max-width: 820px) {
    .nav,
    .nav-cta {
      display: none;
    }

    .nav-toggle {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
    }

    .mobile-menu {
      display: block;
      background: rgba(11, 13, 26, 0.97);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      padding: var(--space-5) var(--space-4) var(--space-6);
    }

    .mobile-menu[hidden] {
      display: none;
    }

    .mobile-list {
      display: grid;
      gap: 0.25rem;
    }

    .mobile-link {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.9rem 0.5rem;
      font-size: var(--fs-lg);
      font-weight: 600;
      border-radius: var(--radius-md);
      transition: var(--transition);
    }

    .mobile-link:hover {
      background: var(--surface);
      color: var(--primary);
    }

    .mobile-num {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--primary);
    }

    .mobile-cta {
      margin-top: var(--space-5);
      width: 100%;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.getElementById('mobile-menu');
  const openIcon = toggle.querySelector('.icon-open');
  const closeIcon = toggle.querySelector('.icon-close');

  function setMenu(open) {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    openIcon.style.display = open ? 'none' : 'block';
    closeIcon.style.display = open ? 'block' : 'none';
  }

  toggle.addEventListener('click', () => setMenu(menu.hidden));

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 820) setMenu(false);
  });
</script>
