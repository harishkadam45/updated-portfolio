---
import { navLinks, site } from '@/data/site';
import Icon from './Icon.astro';

import logoAsset from '@/assets/Harish_kadam.png';

const currentYear = new Date().getFullYear();
---

<header class="header">
  <div class="container header-inner">
    <a href="#top" class="brand" aria-label={`${site.name} — home`}>
      <img class="brand-mark" src={logoAsset.src} alt={site.name} width={logoAsset.width} height={logoAsset.height} />
      <span class="brand-text">
        <span class="brand-name">{site.name}</span>
        <span class="brand-role">// {site.role}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul role="list" class="nav-list">
        {navLinks.map((link) => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="#contact" class="btn btn-primary btn-sm nav-cta">Let's Talk</a>

    <button class="nav-toggle" data-nav-toggle aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-menu">
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul role="list" class="mobile-list">
      {navLinks.map((link, i) => (
        <li class:list={[{ 'has-num': true }]}>
          <a href={link.href} class="mobile-link">
            <span class="mobile-num">0{i + 1}</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="#contact" class="btn btn-primary mobile-cta">Get In Touch</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(6, 7, 14, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-mark {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-strong);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-weight: 700;
    font-size: var(--fs-sm);
  }

  .brand-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
  }

  .nav-list {
    display: flex;
    gap: 1.75rem;
  }

  .nav-link {
    font-size: var(--fs-sm);
    color: var(--text-2);
    transition: var(--transition);
    position: relative;
  }

  .nav-link:hover::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 2px;
    width: 100%;
    background: var(--gradient);
    border-radius: var(--radius-full);
  }

  .nav-link:hover {
    color: var(--text-1);
  }

  .nav-cta {
    padding: 0.5rem 1.1rem;
  }

  .nav-toggle {
    display: none;
    color: var(--text-1);
  }

  .mobile-menu {
    display: none;
  }

  .icon-close {
    display: none;
  }

  @media (max-width: 820px) {
    .nav,
    .nav-cta {
      display: none;
    }

    .nav-toggle {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
    }

    .mobile-menu {
      display: block;
      background: rgba(11, 13, 26, 0.97);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      padding: var(--space-5) var(--space-4) var(--space-6);
    }

    .mobile-menu[hidden] {
      display: none;
    }

    .mobile-list {
      display: grid;
      gap: 0.25rem;
    }

    .mobile-link {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.9rem 0.5rem;
      font-size: var(--fs-lg);
      font-weight: 600;
      border-radius: var(--radius-md);
      transition: var(--transition);
    }

    .mobile-link:hover {
      background: var(--surface);
      color: var(--primary);
    }

    .mobile-num {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--primary);
    }

    .mobile-cta {
      margin-top: var(--space-5);
      width: 100%;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.getElementById('mobile-menu');
  const openIcon = toggle.querySelector('.icon-open');
  const closeIcon = toggle.querySelector('.icon-close');

  function setMenu(open) {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    openIcon.style.display = open ? 'none' : 'block';
    closeIcon.style.display = open ? 'block' : 'none';
  }

  toggle.addEventListener('click', () => setMenu(menu.hidden));

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 820) setMenu(false);
  });
</script>
