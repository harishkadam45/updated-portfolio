---
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import Icon from './Icon.astro';
import portrait from '@/assets/Harish_kadam.png';
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="grid-overlay"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-intro reveal" style="--d:0">
          <span class="dot"></span> Hi, my name is
        </p>

        <h1 class="hero-name reveal" style="--d:1">
          <span class="stroke">{site.name}.</span>
          <span class="text-gradient">I build for the web.</span>
        </h1>

        <p class="hero-role reveal" style="--d:2">{site.role}</p>

        <p class="hero-desc reveal" style="--d:3">
          I'm a {site.role.toLowerCase()} passionate about crafting fast, accessible,
          and pixel-perfect digital products. I turn complex problems into simple,
          elegant, and delightful experiences.
        </p>

        <div class="hero-actions reveal" style="--d:4">
          <a href="#projects" class="btn btn-primary">
            View Projects <Icon name="arrow-right" size={16} />
          </a>
          <a href="#contact" class="btn btn-ghost">
            Get In Touch <Icon name="mail" size={16} />
          </a>
        </div>

        <div class="hero-socials reveal" style="--d:5">
          <a class="icon-link" href={site.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
            <Icon name="github" size={20} />
          </a>
          <a class="icon-link" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
            <Icon name="linkedin" size={20} />
          </a>
          <a class="icon-link" href={`mailto:${site.email}`} aria-label="Email">
            <Icon name="mail" size={20} />
          </a>
        </div>
      </div>

      <div class="hero-media reveal" style="--d:2">
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt={`${site.name} — ${site.role}`}
            width={2048}
            height={2048}
            class="portrait"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: var(--space-10);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 40%, transparent 100%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
  }

  .orb-1 {
    width: 480px;
    height: 480px;
    background: rgba(109, 123, 255, 0.35);
    top: -120px;
    right: -80px;
  }

  .orb-2 {
    width: 380px;
    height: 380px;
    background: rgba(167, 139, 250, 0.25);
    bottom: -100px;
    left: -60px;
  }

  .hero-content {
    max-width: var(--container);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-10);
    align-items: center;
  }

  .hero-copy {
    max-width: 40rem;
  }

  .hero-media {
    display: flex;
    justify-content: center;
  }

  .portrait-frame {
    position: relative;
    max-width: 380px;
    width: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: linear-gradient(160deg, var(--bg-3), var(--bg-1));
  }

  /* gradient ring behind portrait */
  .portrait-frame::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    background: var(--gradient);
    opacity: 0.6;
    z-index: 0;
  }

  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: calc(var(--radius-xl) - 2px);
    background: var(--bg-1);
    z-index: 1;
  }

  .portrait {
    position: relative;
    z-index: 2;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: calc(var(--radius-xl) - 2px);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero-media {
      order: -1;
    }

    .portrait-frame {
      max-width: 280px;
    }
  }

  .hero-intro {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    color: var(--primary);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-5);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.15);
  }

  .hero-name {
    font-size: var(--fs-hero);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }

  .stroke {
    display: block;
    color: var(--text-1);
  }

  .hero-role {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: var(--space-4);
  }

  .hero-desc {
    font-size: var(--fs-lg);
    color: var(--text-2);
    max-width: 38rem;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .hero-socials {
    display: flex;
    gap: var(--space-3);
  }

  .reveal {
    transition-delay: calc(var(--d, 0) * 80ms);
  }
</style>
